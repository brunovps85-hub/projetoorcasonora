# Set these in your hosting provider's secret/environment settings.
PORT=3000
NODE_ENV=development

# Browser app's exact origin, e.g. https://example.com (no trailing slash).
FRONTEND_ORIGIN=http://localhost:3000

# Supabase project settings. The anon/publishable key is public, never use service_role here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Secret: create a NEW ElevenLabs key after revoking the exposed one.
ELEVENLABS_API_KEY=replace_with_new_server_side_secret

# Only allow the voice IDs the app needs.
ALLOWED_VOICE_IDS=pNInz6obpgDQGcFmaJgB,onwK4e9ZLuTAKqWW03F9
